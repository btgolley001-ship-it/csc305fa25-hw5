doctype html
html
  head
    link(rel='stylesheet', href='/stylesheets/style.css')
    |	<style>
    |		/* Indicate required elements */
    |		.flag { color: firebrick; }
    |
    |		/* The required flag starts out as a red asterisk. */
    |		.flag::before {
    |			content: "*";
    |			padding-left: 2px;
    |		}
    |
    |		/* Change the red * to a green check once the control has been filled in.  
    |   			The ~ is for selecting siblings without requiring that they be right 
    |   			next to each other. */
    |		:required:valid ~ .flag::before, .flag.valid::before {
    |			content: '✓';
    |			color: green;
    |		}
    |
    |		.graduation > input { margin-left: 2em;	}
    |
    |		ul {
    |			list-style-type: none;
    |            margin-top: 0;
    |		}
    |
    |        div { margin-bottom: 0.5em; }
    |
    |		.explanations { padding: 0; }
    |	</style>
  body
    block content
    if title == 'Form Page First View'
      h1= 'Homework 5'
    if title == 'Form Page'
      h1= ''
    if formdata.nameblank != undefined
      p Figuring out how to use formdata! We recognized ourself!
      p Welcome to the second iteration of this page!
    else 
      p We're not recognizing any past formdata...

